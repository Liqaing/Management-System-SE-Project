model category {
  id           Int       @id @default(autoincrement())
  categoryName String    @unique @db.VarChar(255)
  description  String?   @db.VarChar
  createAt     DateTime? @default(now())
  createBy     String?   @db.VarChar(255)
  updateAt     DateTime?
  updateBy     String?   @db.VarChar(255)
  createById   Int?
  updateById   Int?
  product      product[]
}

