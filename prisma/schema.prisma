model productImage {
  id        Int     @id @default(autoincrement())
  image     Bytes
  productId Int
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model coupon {
  id                 Int      @id @default(autoincrement())
  couponCode         String   @unique @db.VarChar(6)
  DiscountPercentage Float
  status             String   @db.VarChar(50)
  effectiveDate      DateTime
  expireDate         DateTime
  limitUsange        Int
  couponType         String   @db.VarChar(30)

  createById Int?
  createBy   String?   @db.VarChar(255)
  createAt   DateTime? @default(now())
  updateById Int?
  updateBy   String?   @db.VarChar(255)
  updateAt   DateTime?
}

model orderHeader {
  id         Int      @id @default(autoincrement())
  orderDate  DateTime
  totalPrice Float
  discount   Float
  grandTotal Float

  orderStatus String  @db.VarChar(50)
  remark      String? @db.VarChar
  orderType   String  @db.VarChar(50)

  discountPercentage Float?
  couponCode         String? @db.VarChar(6)

  paymentMethod   String  @db.VarChar(50)
  SessionId       String?
  PaymentIntentId String?

  orderBy   String? @db.VarChar(255)
  orderById Int?
  user      users?  @relation(fields: [orderById], references: [id])

  telephone String? @db.VarChar(255)

  // Address

  createById Int?
  createBy   String?   @db.VarChar(255)
  createAt   DateTime? @default(now())
  updateById Int?
  updateBy   String?   @db.VarChar(255)
  updateAt   DateTime?

  orderDetail orderDetail[]
}

model orderDetail {
  id Int @id @default(autoincrement())

  orderHeader   orderHeader @relation(fields: [orderHeaderId], references: [id])
  orderHeaderId Int

  product   product @relation(fields: [productId], references: [id])
  productId Int

  productName   String @db.VarChar(300)
  categoryName  String @db.VarChar(255)
  orderQuantity Int
  unitPrice     Float
  totalPrice    Float
}

model cart {
  id            Int     @id @default(autoincrement())
  Product       product @relation(fields: [productId], references: [id])
  productId     Int
  productName   String  @db.VarChar(300)
  categoryName  String  @db.VarChar(255)
  orderQuantity Int
  unitPrice     Float
  totalPrice    Float
  isActive      Boolean

  user   users @relation(fields: [userId], references: [id])
  userId Int

  createById Int?
  createBy   String?   @db.VarChar(255)
  createAt   DateTime? @default(now())
  updateById Int?
  updateBy   String?   @db.VarChar(255)
  updateAt   DateTime?
}
